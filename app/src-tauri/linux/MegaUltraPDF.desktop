# SPDX-License-Identifier: GPL-3.0-or-later
# Modèle du fichier .desktop des paquets Linux (deb, AppImage). Celui de Tauri par défaut, plus
# `%F` sur la ligne Exec : sans lui, un PDF ouvert depuis le gestionnaire de fichiers lancerait
# l'application sans le fichier (correctif 0.11.1).
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
