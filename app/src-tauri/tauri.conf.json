{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MegaUltraPDF",
  "version": "0.12.1",
  "identifier": "org.megaultrapdf.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "MegaUltraPDF",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' mega: http://mega.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "publisher": "MegaUltraPDF",
    "shortDescription": "Lecteur et éditeur PDF libre",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "MegaUltraPDF.Document",
        "description": "Document PDF",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/MegaUltraPDF.desktop"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
