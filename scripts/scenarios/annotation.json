[
  { "wait": 1500 },
  { "assert": "document.querySelectorAll('.page img').length >= 1", "label": "page rendue" },
  { "assert": "document.querySelector('.annotation-toolbar') !== null", "label": "barre d'annotation présente" },
  { "eval": "(() => { [...document.querySelectorAll('[role=tab]')].find(b => b.textContent.trim() === 'Annotations').click(); return true; })()", "label": "onglet Annotations ouvert" },
  { "wait": 500 },
  { "assert": "document.body.innerText.includes('Aucune annotation')", "label": "panneau vide au départ" },

  { "drag": ".page[data-page='0'] .text-layer", "from": [70, 80], "to": [160, 90] },
  { "wait": 300 },
  { "assert": "document.querySelectorAll('.sel').length >= 1", "label": "texte sélectionné" },
  { "click": "button[aria-label='Surligner la sélection']" },
  { "wait": 1800 },
  { "assert": "document.querySelectorAll('.panel li').length === 1 && document.body.innerText.includes('Surlignage')", "label": "1 surlignage dans le panneau" },
  { "assert": "document.querySelector('button[title^=\"Annuler : Ajouter : Surlignage\"]') !== null", "label": "libellé d'annulation « Ajouter : Surlignage »" },
  { "shot": "01-surlignage.png" },

  { "click": "button[aria-label='Note']" },
  { "drag": ".page[data-page='0'] .annotation-layer", "from": [400, 120], "to": [400, 120] },
  { "wait": 400 },
  { "assert": "document.querySelector('.annotation-layer textarea') !== null", "label": "saisie de la note ouverte" },
  { "type": "Bonjour" },
  { "key": "Enter", "ctrl": true },
  { "wait": 1800 },
  { "assert": "document.querySelectorAll('.panel li').length === 2 && document.body.innerText.includes('Bonjour')", "label": "note créée avec son extrait" },
  { "assert": "document.querySelectorAll('.annotation-layer .note').length === 1", "label": "zone de la note présente dans le calque" },
  { "shot": "02-note.png" },

  { "click": "button[aria-label='Rectangle']" },
  { "drag": ".page[data-page='0'] .annotation-layer", "from": [100, 300], "to": [260, 420] },
  { "wait": 1800 },
  { "assert": "document.querySelectorAll('.panel li').length === 3 && document.body.innerText.includes('Rectangle')", "label": "rectangle créé" },
  { "assert": "document.querySelectorAll('.annotation-layer .handle').length === 4", "label": "rectangle sélectionné avec 4 poignées" },
  { "shot": "03-rectangle.png" },
  { "key": "Escape" },
  { "wait": 200 },
  { "drag": ".page[data-page='0'] .annotation-layer .handle[data-handle='se']", "from": [4, 4], "to": [44, 44] },
  { "wait": 1800 },
  { "assert": "document.querySelector('button[title^=\"Annuler : Déplacer : Rectangle\"]') !== null", "label": "redimensionnement = « Déplacer : Rectangle »" },
  { "assert": "document.querySelectorAll('.annotation-layer .handle').length === 4", "label": "le rectangle recréé reste sélectionné" },
  { "key": "Delete" },
  { "wait": 1500 },
  { "assert": "document.querySelectorAll('.panel li').length === 2", "label": "Suppr : rectangle supprimé" },
  { "key": "z", "ctrl": true },
  { "wait": 1500 },
  { "assert": "document.querySelectorAll('.panel li').length === 3", "label": "Ctrl+Z : rectangle revenu" },

  { "click": "button[aria-label='Dessiner']" },
  { "drag": ".page[data-page='0'] .annotation-layer", "from": [300, 300], "to": [380, 360] },
  { "wait": 1800 },
  { "assert": "document.querySelectorAll('.panel li').length === 4 && document.body.innerText.includes('Encre')", "label": "tracé à main levée créé" },
  { "click": "button[aria-label='Flèche']" },
  { "drag": ".page[data-page='0'] .annotation-layer", "from": [300, 450], "to": [420, 520] },
  { "wait": 1800 },
  { "assert": "document.querySelectorAll('.panel li').length === 5 && document.body.innerText.includes('Flèche')", "label": "flèche créée" },
  { "shot": "04-encre-fleche.png" },

  { "click": "button[aria-label='Texte']" },
  { "drag": ".page[data-page='0'] .annotation-layer", "from": [100, 500], "to": [300, 540] },
  { "wait": 400 },
  { "assert": "document.querySelector('.annotation-layer textarea') !== null", "label": "saisie du texte libre ouverte" },
  { "type": "Essai" },
  { "key": "Enter", "ctrl": true },
  { "wait": 1800 },
  { "assert": "document.querySelectorAll('.panel li').length === 6 && document.body.innerText.includes('Essai')", "label": "texte libre créé" },

  { "click": "button[aria-label='Tampon']" },
  { "drag": ".page[data-page='0'] .annotation-layer", "from": [250, 560], "to": [250, 560] },
  { "wait": 1800 },
  { "assert": "document.querySelectorAll('.panel li').length === 7 && document.body.innerText.includes('BROUILLON')", "label": "tampon BROUILLON créé" },
  { "shot": "05-texte-tampon.png" },

  { "eval": "(() => { const items = [...document.querySelectorAll('.panel li .item')]; items[0].dispatchEvent(new MouseEvent('dblclick', { bubbles: true })); return items.length; })()", "label": "double-clic sur la première entrée" },
  { "wait": 500 },
  { "assert": "document.querySelector('#ann-title') !== null", "label": "éditeur d'annotation ouvert" },
  { "shot": "06-editeur.png" },
  { "key": "Escape" },
  { "wait": 300 },
  { "assert": "document.querySelector('#ann-title') === null", "label": "éditeur fermé par Échap" },

  { "key": "s", "ctrl": true },
  { "wait": 1200 },
  { "assert": "!document.querySelector('[role=tablist][aria-label=MegaUltraPDF] [role=tab]').textContent.trim().endsWith('•')", "label": "enregistré (marque « • » disparue)" },
  { "shot": "07-enregistre.png" }
]
