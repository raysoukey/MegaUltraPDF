[
  {"wait": 1800},
  {"assert": "document.querySelectorAll('.page img').length >= 1", "label": "page rendue"},
  {"assert": "document.querySelector('[aria-label=\"Outils de contenu\"]') !== null", "label": "groupe d'outils de contenu présent"},
  {"click": "button[aria-label='Texte dans la page']"},
  {"drag": ".page[data-page='0'] .object-layer", "from": [100, 150], "to": [100, 150]},
  {"wait": 500},
  {"assert": "document.querySelector('#text-insert-title') !== null", "label": "dialogue d'insertion de texte ouvert"},
  {"eval": "(() => { const a = document.querySelector('.dialog textarea'); a.value = 'Bonjour'; a.dispatchEvent(new Event('input', { bubbles: true })); const s = document.querySelector('.dialog input[type=number]'); s.value = '18'; s.dispatchEvent(new Event('input', { bubbles: true })); return true; })()", "label": "texte « Bonjour », taille 18"},
  {"eval": "(() => { [...document.querySelectorAll('.dialog button')].find(b => b.textContent.trim() === 'Insérer').click(); return true; })()", "label": "clic « Insérer »"},
  {"wait": 2000},
  {"assert": "document.querySelector('#text-insert-title') === null && document.querySelector('button[title^=\"Annuler : Insérer du texte\"]') !== null", "label": "texte inséré (libellé d'annulation)"},
  {"click": "button[aria-label='Objets de la page']"},
  {"wait": 1200},
  {"assert": "document.querySelectorAll('.page[data-page=\\'0\\'] .object-layer rect.object').length === 2", "label": "2 objets listés sur la page 1 (« Page 1 » + « Bonjour »)"},
  {"assert": "document.querySelector('.page[data-page=\\'0\\'] rect.object[data-object=\"1\"]').getAttribute('data-kind') === 'text'", "label": "le nouvel objet est un texte"},
  {"shot": "01-objets.png"},
  {"eval": "(() => { const r = document.querySelector('.page[data-page=\\'0\\'] rect.object[data-object=\"1\"]'); window.__objBefore = Number(r.getAttribute('x')); return true; })()", "label": "position mémorisée"},
  {"drag": ".page[data-page='0'] rect.object[data-object='1']", "from": [5, 5], "to": [65, 5]},
  {"wait": 2000},
  {"assert": "document.querySelector('button[title^=\"Annuler : Déplacer : Texte\"]') !== null", "label": "libellé « Déplacer : Texte »"},
  {"assert": "(() => { const r = document.querySelector('.page[data-page=\\'0\\'] rect.object[data-object=\"1\"]'); return Number(r.getAttribute('x')) - window.__objBefore > 40; })()", "label": "l'objet a bougé vers la droite"},
  {"assert": "document.querySelector('.page[data-page=\\'0\\'] rect.object.selected') !== null", "label": "l'objet déplacé reste sélectionné"},
  {"eval": "(() => { const r = document.querySelector('.page[data-page=\\'0\\'] rect.object[data-object=\"1\"]'); const b = r.getBoundingClientRect(); const layer = document.querySelector('.page[data-page=\\'0\\'] .object-layer'); layer.dispatchEvent(new MouseEvent('dblclick', { bubbles: true, clientX: b.left + b.width / 2, clientY: b.top + b.height / 2 })); return true; })()", "label": "double-clic sur le texte"},
  {"wait": 400},
  {"assert": "document.querySelector('.object-layer textarea') !== null && document.querySelector('.object-layer textarea').value === 'Bonjour'", "label": "saisie ouverte avec le texte actuel"},
  {"eval": "(() => { const a = document.querySelector('.object-layer textarea'); a.value = 'Salut'; a.dispatchEvent(new Event('input', { bubbles: true })); return true; })()", "label": "nouveau texte « Salut »"},
  {"key": "Enter", "ctrl": true},
  {"wait": 2000},
  {"assert": "document.querySelector('button[title^=\"Annuler : Modifier le texte\"]') !== null", "label": "libellé « Modifier le texte »"},
  {"shot": "02-texte-modifie.png"},
  {"key": "Delete"},
  {"wait": 2000},
  {"assert": "document.querySelector('button[title^=\"Annuler : Supprimer : Texte\"]') !== null", "label": "Suppr : « Supprimer : Texte »"},
  {"assert": "document.querySelectorAll('.page[data-page=\\'0\\'] .object-layer rect.object').length === 1", "label": "il reste 1 objet"},
  {"key": "z", "ctrl": true},
  {"wait": 2000},
  {"assert": "document.querySelectorAll('.page[data-page=\\'0\\'] .object-layer rect.object').length === 2", "label": "Ctrl+Z : objet revenu"},
  {"assert": "document.querySelector('button[aria-label=\"Supprimer l’objet\"]').disabled === true", "label": "après Ctrl+Z, plus d'objet sélectionné (Suppr désactivé)"},
  {"click": "button[aria-label='Caviarder']"},
  {"drag": ".page[data-page='0'] .object-layer", "from": [60, 60], "to": [220, 110]},
  {"wait": 500},
  {"assert": "document.querySelector('#redact-title') !== null", "label": "confirmation de caviardage"},
  {"eval": "(() => { [...document.querySelectorAll('.dialog button')].find(b => b.textContent.trim() === 'Caviarder').click(); return true; })()", "label": "clic « Caviarder »"},
  {"wait": 2500},
  {"assert": "document.querySelector('#redact-title') === null && document.querySelector('button[title^=\"Annuler : Caviarder\"]') !== null", "label": "zone caviardée"},
  {"click": "button[aria-label='Objets de la page']"},
  {"wait": 1200},
  {"assert": "[...document.querySelectorAll('.page[data-page=\\'0\\'] rect.object')].every(r => r.getAttribute('data-kind') !== 'text' || true) && document.querySelectorAll('.page[data-page=\\'0\\'] rect.object[data-kind=path]').length === 1", "label": "le cache noir (chemin) est là"},
  {"shot": "03-caviarde.png"},
  {"eval": "(() => { [...document.querySelectorAll('[aria-label=\"Outils de contenu\"] button')].find(b => b.textContent.trim().startsWith('Contenu')).click(); return true; })()", "label": "menu Contenu ouvert"},
  {"wait": 200},
  {"eval": "(() => { [...document.querySelectorAll('[role=menuitem]')].find(b => b.textContent.trim().startsWith('Filigrane')).click(); return true; })()", "label": "Filigrane…"},
  {"wait": 400},
  {"assert": "document.querySelector('#watermark-title') !== null", "label": "dialogue de filigrane"},
  {"eval": "(() => { [...document.querySelectorAll('.dialog button')].find(b => b.textContent.trim() === 'Appliquer').click(); return true; })()", "label": "clic « Appliquer »"},
  {"wait": 3000},
  {"assert": "document.querySelector('button[title^=\"Annuler : Filigraner 3 pages\"]') !== null", "label": "libellé « Filigraner 3 pages »"},
  {"shot": "04-filigrane.png"},
  {"eval": "(() => { [...document.querySelectorAll('[aria-label=\"Outils de contenu\"] button')].find(b => b.textContent.trim().startsWith('Contenu')).click(); return true; })()", "label": "menu Contenu ouvert"},
  {"wait": 200},
  {"eval": "(() => { [...document.querySelectorAll('[role=menuitem]')].find(b => b.textContent.trim().startsWith('Numérotation')).click(); return true; })()", "label": "Numérotation…"},
  {"wait": 400},
  {"assert": "document.querySelector('#numbering-title') !== null && document.body.innerText.includes('Aperçu : 1 / 3')", "label": "dialogue de numérotation avec aperçu"},
  {"eval": "(() => { [...document.querySelectorAll('.dialog button')].find(b => b.textContent.trim() === 'Appliquer').click(); return true; })()", "label": "clic « Appliquer »"},
  {"wait": 3000},
  {"assert": "document.querySelector('button[title^=\"Annuler : Numéroter 3 pages\"]') !== null", "label": "libellé « Numéroter 3 pages »"},
  {"eval": "(() => { const r = document.querySelector('.page[data-page=\\'0\\']').getBoundingClientRect(); window.__pageRatio = r.width / r.height; return true; })()", "label": "proportions de page mémorisées (A4 ≈ 0,707)"},
  {"eval": "(() => { [...document.querySelectorAll('[aria-label=\"Outils de contenu\"] button')].find(b => b.textContent.trim().startsWith('Contenu')).click(); return true; })()", "label": "menu Contenu ouvert"},
  {"wait": 200},
  {"eval": "(() => { [...document.querySelectorAll('[role=menuitem]')].find(b => b.textContent.trim().startsWith('Recadrer')).click(); return true; })()", "label": "Recadrer…"},
  {"wait": 400},
  {"assert": "document.querySelector('#crop-title') !== null", "label": "dialogue de recadrage"},
  {"eval": "(() => { for (const i of document.querySelectorAll('.dialog input[type=number]')) { i.value = '50'; i.dispatchEvent(new Event('input', { bubbles: true })); } return true; })()", "label": "marges 50 pt"},
  {"eval": "(() => { [...document.querySelectorAll('.dialog button')].find(b => b.textContent.trim() === 'Recadrer').click(); return true; })()", "label": "clic « Recadrer »"},
  {"wait": 3000},
  {"assert": "document.querySelector('button[title^=\"Annuler : Recadrer 1 page\"]') !== null", "label": "libellé « Recadrer 1 page »"},
  {"assert": "(() => { const r = document.querySelector('.page[data-page=\\'0\\']').getBoundingClientRect(); const ratio = r.width / r.height; return Math.abs(window.__pageRatio - 0.707) < 0.02 && Math.abs(ratio - 495.3 / 741.9) < 0.02; })()", "label": "la page 1 a les proportions recadrées (495 × 742), quel que soit le zoom"},
  {"shot": "05-recadre.png"},
  {"key": "s", "ctrl": true},
  {"wait": 2500},
  {"assert": "!document.querySelector('[role=tablist][aria-label=MegaUltraPDF] [role=tab]').textContent.trim().endsWith('•')", "label": "enregistré"}
