  {
    "eval": "(() => { const r = document.querySelector('input[value=ranges]'); r.click(); const i = document.querySelector('input[placeholder^=\"ex.\"]'); i.value = '1,2-3'; i.dispatchEvent(new Event('input', { bubbles: true })); return true; })()",
    "label": "mode plages « 1,2-3 »"
  },
