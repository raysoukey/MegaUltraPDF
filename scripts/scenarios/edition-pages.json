[
  {
    "wait": 1500
  },
  {
    "assert": "document.querySelectorAll('.thumb').length === 3",
    "label": "trois vignettes"
  },
  {
    "assert": "document.querySelector('button[title^=\"Annuler\"]').disabled === true",
    "label": "rien à annuler au départ"
  },
  {
    "eval": "(() => { const th = document.querySelectorAll('.thumb'); th[0].dispatchEvent(new MouseEvent('click', { bubbles: true, ctrlKey: true })); th[1].dispatchEvent(new MouseEvent('click', { bubbles: true, ctrlKey: true })); return document.querySelectorAll('.thumb.selected').length; })()",
    "label": "Ctrl+clic sur les pages 1 et 2"
  },
  {
    "assert": "document.querySelectorAll('.thumb.selected').length === 2",
    "label": "deux vignettes sélectionnées"
  },
  {
    "click": "button[title='Pivoter à droite']"
  },
  {
    "wait": 1500
  },
  {
    "assert": "document.querySelector('[role=tab][aria-selected=true]').textContent.trim().endsWith('•')",
    "label": "onglet marqué modifié"
  },
  {
    "assert": "(() => { const im = document.querySelectorAll('.thumb img'); return im[0].width > im[0].height && im[2].width < im[2].height; })()",
    "label": "pages 1-2 en paysage, page 3 inchangée"
  },
  {
    "assert": "document.querySelector('button[title^=\"Annuler : Pivoter 2 pages\"]') !== null",
    "label": "libellé d'annulation « Pivoter 2 pages »"
  },
  {
    "shot": "01-rotation.png"
  },
  {
    "eval": "(() => { const list = document.querySelector('.panel .list'); let th = document.querySelectorAll('.thumb'); const a = th[0].getBoundingClientRect(); const x = a.left + 10, y0 = a.top + a.height / 2; const ev = (el, type, y) => el.dispatchEvent(new PointerEvent(type, { bubbles: true, cancelable: true, pointerId: 1, isPrimary: true, button: 0, buttons: type === 'pointerup' ? 0 : 1, clientX: x, clientY: y })); ev(th[0], 'pointerdown', y0); ev(th[0], 'pointermove', y0 + 10); list.scrollTop = list.scrollHeight; const third = [...document.querySelectorAll('.thumb')].find((b) => b.getAttribute('aria-label').startsWith('Page 3 ')); const r = third.getBoundingClientRect(); const lr = list.getBoundingClientRect(); const y = Math.min(r.bottom - 5, lr.bottom - 40); ev(document.body, 'pointermove', y); const ind = document.querySelector('.drop-indicator') !== null; ev(document.body, 'pointerup', y); return 'indicateur : ' + ind; })()",
    "label": "glisser la sélection (pages 1-2) après la page 3"
  },
  {
    "wait": 1800
  },
  {
    "assert": "document.querySelector('button[title^=\"Annuler : Déplacer\"]') !== null",
    "label": "libellé d'annulation « Déplacer »"
  },
  {
    "key": "f",
    "ctrl": true
  },
  {
    "wait": 400
  },
  {
    "type": "Page 3"
  },
  {
    "wait": 1500
  },
  {
    "assert": "document.querySelector('.searchbar .count').textContent.includes('/ 1') && document.querySelector('input[aria-label=\"Numéro de page\"]').value === '1'",
    "label": "« Page 3 » est maintenant la page 1 (recherche rechargée)"
  },
  {
    "key": "Escape"
  },
  {
    "wait": 300
  },
  {
    "assert": "[...document.querySelectorAll('.thumb.selected span')].map(s => s.textContent).join() === '2,3'",
    "label": "les pages déplacées restent sélectionnées (en 2 et 3)"
  },
  {
    "shot": "02-deplacement.png"
  },
  {
    "eval": "(() => { document.querySelectorAll('.thumb')[1].click(); return true; })()",
    "label": "clic simple sur la page 2"
  },
  {
    "click": "button[title='Supprimer']"
  },
