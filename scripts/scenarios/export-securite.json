[
  { "wait": 1800 },
  { "assert": "document.querySelectorAll('.page img').length >= 1", "label": "page rendue" },
  { "assert": "[...document.querySelectorAll('header.toolbar button')].some(b => b.textContent.trim().startsWith('Fichier'))", "label": "menu Fichier présent" },

  { "key": "i", "ctrl": true },
  { "wait": 800 },
  { "assert": "document.querySelector('#props-title') !== null && document.querySelector('.dialog input[type=text]') !== null", "label": "Propriétés : champs modifiables" },
  { "eval": "(() => { const inputs = document.querySelectorAll('.dialog input[type=text]'); inputs[0].value = 'Titre modifié'; inputs[0].dispatchEvent(new Event('input', { bubbles: true })); inputs[1].value = 'Zoë'; inputs[1].dispatchEvent(new Event('input', { bubbles: true })); return true; })()", "label": "titre et auteur saisis" },
  { "eval": "(() => { [...document.querySelectorAll('.dialog button')].find(b => b.textContent.trim() === 'Enregistrer').click(); return true; })()", "label": "clic « Enregistrer » (métadonnées)" },
  { "wait": 2500 },
  { "assert": "document.querySelector('button[title^=\"Annuler : Modifier les métadonnées\"]') !== null", "label": "libellé « Modifier les métadonnées »" },
  { "assert": "document.querySelector('[role=tablist][aria-label=MegaUltraPDF] [role=tab]').textContent.includes('Titre modifié')", "label": "onglet renommé avec le nouveau titre" },
  { "assert": "document.body.innerText.includes('Non protégé')", "label": "état de sécurité affiché" },
  { "shot": "01-proprietes.png" },
  { "key": "Escape" },
  { "wait": 300 },

  { "eval": "(() => { [...document.querySelectorAll('header.toolbar button')].find(b => b.textContent.trim().startsWith('Fichier')).click(); return true; })()", "label": "menu Fichier ouvert" },
  { "wait": 200 },
  { "eval": "(() => { [...document.querySelectorAll('[role=menuitem]')].find(b => b.textContent.trim().startsWith('Optimiser')).click(); return true; })()", "label": "Optimiser…" },
  { "wait": 500 },
  { "assert": "document.querySelector('#optimize-title') !== null", "label": "dialogue Optimiser" },
  { "eval": "(() => { [...document.querySelectorAll('.dialog button')].find(b => b.textContent.trim() === 'Optimiser').click(); return true; })()", "label": "clic « Optimiser »" },
  { "wait": 3000 },
  { "assert": "document.body.innerText.includes('Optimisation appliquée') && document.querySelector('button[title^=\"Annuler : Optimiser\"]') !== null", "label": "optimisation appliquée et annulable" },
  { "shot": "02-optimise.png" },
  { "key": "Escape" },
  { "wait": 300 },

  { "eval": "(() => { [...document.querySelectorAll('header.toolbar button')].find(b => b.textContent.trim().startsWith('Fichier')).click(); return true; })()", "label": "menu Fichier ouvert" },
  { "wait": 200 },
  { "eval": "(() => { [...document.querySelectorAll('[role=menuitem]')].find(b => b.textContent.trim().startsWith('Exporter')).click(); return true; })()", "label": "Exporter…" },
  { "wait": 500 },
  { "assert": "document.querySelector('#export-title') !== null && document.body.innerText.includes('Résolution (dpi)') && document.body.innerText.includes('Préfixe des fichiers')", "label": "dialogue Exporter avec ses options" },
  { "assert": "[...document.querySelectorAll('.dialog button[type=submit]')].every(b => b.disabled)", "label": "export d’images désactivé sans dossier" },
  { "shot": "03-export.png" },
  { "key": "Escape" },
  { "wait": 300 },

  { "eval": "(() => { window.__printed = 0; window.print = () => { window.__printed += 1; }; return true; })()", "label": "window.print espionné" },
  { "key": "p", "ctrl": true },
  { "wait": 4000 },
  { "assert": "document.querySelector('#print-title') !== null && document.querySelectorAll('.print-view img').length === 3", "label": "vue d’impression : 3 pages" },
  { "assert": "(() => { const b = [...document.querySelectorAll('.print-view button')].find(b => b.textContent.trim() === 'Imprimer'); return b && !b.disabled; })()", "label": "pages prêtes, bouton Imprimer actif" },
  { "eval": "(() => { [...document.querySelectorAll('.print-view button')].find(b => b.textContent.trim() === 'Imprimer').click(); return true; })()", "label": "clic « Imprimer »" },
  { "wait": 300 },
  { "assert": "window.__printed === 1", "label": "window.print appelé une fois" },
  { "shot": "04-impression.png" },
  { "key": "Escape" },
  { "wait": 300 },
  { "assert": "document.querySelector('#print-title') === null", "label": "Échap ferme la vue d’impression" },

  { "eval": "(() => { [...document.querySelectorAll('header.toolbar button')].find(b => b.textContent.trim().startsWith('Fichier')).click(); return true; })()", "label": "menu Fichier ouvert" },
  { "wait": 200 },
  { "eval": "(() => { [...document.querySelectorAll('[role=menuitem]')].find(b => b.textContent.trim().startsWith('Protéger')).click(); return true; })()", "label": "Protéger…" },
  { "wait": 600 },
  { "assert": "document.querySelector('#protect-title') !== null", "label": "dialogue Protéger" },
  { "eval": "(() => { const pw = document.querySelectorAll('.dialog input[type=password]'); pw[0].value = 'secret'; pw[0].dispatchEvent(new Event('input', { bubbles: true })); pw[1].value = 'secret'; pw[1].dispatchEvent(new Event('input', { bubbles: true })); const cb = document.querySelectorAll('.dialog fieldset input[type=checkbox]'); cb[0].click(); return true; })()", "label": "mot de passe « secret », impression interdite" },
  { "eval": "(() => { [...document.querySelectorAll('.dialog button')].find(b => b.textContent.trim() === 'Protéger').click(); return true; })()", "label": "clic « Protéger »" },
  { "wait": 3000 },
  { "assert": "document.querySelector('#protect-title') === null && document.querySelector('button[title^=\"Annuler : Protéger le document\"]') !== null", "label": "document protégé (libellé d’annulation)" },
  { "key": "i", "ctrl": true },
  { "wait": 800 },
  { "assert": "document.body.innerText.includes('Protégé par mot de passe') && document.body.innerText.includes('impression interdite')", "label": "Propriétés : protégé, impression interdite" },
  { "shot": "05-protege.png" },
  { "key": "Escape" },
  { "wait": 300 },

  { "key": "s", "ctrl": true },
  { "wait": 2500 },
  { "assert": "!document.querySelector('[role=tablist][aria-label=MegaUltraPDF] [role=tab]').textContent.trim().endsWith('•')", "label": "enregistré (chiffré)" }
]
