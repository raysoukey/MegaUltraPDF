    "eval": "(() => { const v = document.querySelector('.viewer'); const p = document.querySelectorAll('.page')[1]; const top = p.getBoundingClientRect().top - v.getBoundingClientRect().top + v.scrollTop; window.__target = Math.round(top + p.offsetHeight / 2); v.scrollTop = window.__target; return window.__target; })()",
    "label": "défilement : milieu de la page 2"
  },
