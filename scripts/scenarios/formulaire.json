[
  { "wait": 1800 },
  { "assert": "document.querySelectorAll('.form-layer input').length === 6 && document.querySelectorAll('.form-layer textarea').length === 1 && document.querySelectorAll('.form-layer select').length === 1", "label": "6 champs input, 1 zone de texte, 1 liste" },
  { "assert": "document.querySelector('.form-layer input[aria-label=ref]').readOnly === true", "label": "champ « ref » en lecture seule" },
  { "eval": "(() => { [...document.querySelectorAll('.sidebar [role=tab]')].find(b => b.textContent.trim() === 'Formulaire').click(); return true; })()", "label": "onglet Formulaire ouvert" },
  { "wait": 800 },
  { "assert": "document.body.innerText.includes('8 champs') && document.body.innerText.includes('1 requis vide')", "label": "panneau : 8 champs, 1 requis vide (email)" },
  { "shot": "01-formulaire.png" },

  { "eval": "(() => { const i = document.querySelector('.form-layer input[aria-label=nom]'); i.value = 'Dupont'; i.dispatchEvent(new Event('change', { bubbles: true })); return true; })()", "label": "saisie « Dupont » dans nom" },
  { "wait": 2000 },
  { "assert": "document.querySelector('[role=tablist][aria-label=MegaUltraPDF] [role=tab]').textContent.trim().endsWith('•')", "label": "document modifié" },
  { "assert": "document.querySelector('button[title^=\"Annuler : Remplir : nom\"]') !== null", "label": "libellé « Remplir : nom »" },
  { "assert": "document.querySelector('.form-layer input[aria-label=nom]').value === 'Dupont' && document.body.innerText.includes('Dupont')", "label": "valeur relue dans le calque et le panneau" },
  { "shot": "02-saisie.png" },

  { "eval": "(() => { document.querySelector('.form-layer input[aria-label=ok]').click(); return true; })()", "label": "case « ok » cochée" },
  { "wait": 2000 },
  { "assert": "document.querySelector('.form-layer input[aria-label=ok]').checked === true && document.body.innerText.includes('coché')", "label": "case cochée relue" },
  { "key": "z", "ctrl": true },
  { "wait": 2000 },
  { "assert": "document.querySelector('.form-layer input[aria-label=ok]').checked === false", "label": "Ctrl+Z décoche" },
  { "assert": "document.querySelector('.form-layer input[aria-label=nom]').value === 'Dupont'", "label": "la saisie précédente reste" },

  { "eval": "(() => { const r = document.querySelectorAll('.form-layer input[type=radio]')[1]; r.click(); return true; })()", "label": "radio B coché" },
  { "wait": 2000 },
  { "assert": "(() => { const r = document.querySelectorAll('.form-layer input[type=radio]'); return r[1].checked === true && r[0].checked === false; })()", "label": "B coché, A décoché (groupe cohérent)" },
  { "eval": "(() => { const s = document.querySelector('.form-layer select'); s.value = 'Lyon'; s.dispatchEvent(new Event('change', { bubbles: true })); return true; })()", "label": "liste : Lyon" },
  { "wait": 2000 },
  { "assert": "document.querySelector('.form-layer select').value === 'Lyon' && document.body.innerText.includes('Lyon')", "label": "valeur de liste relue" },

  { "click": "button[aria-label='Signature']" },
  { "drag": ".page[data-page='0'] .annotation-layer", "from": [480, 480], "to": [620, 540] },
  { "wait": 600 },
  { "assert": "document.querySelector('#sig-title') !== null", "label": "dialogue de signature ouvert" },
  { "drag": ".dialog canvas", "from": [20, 100], "to": [200, 60] },
  { "drag": ".dialog canvas", "from": [220, 40], "to": [380, 120] },
  { "wait": 300 },
  { "shot": "03-signature.png" },
  { "eval": "(() => { [...document.querySelectorAll('.dialog button')].find(b => b.textContent.trim() === 'Apposer').click(); return true; })()", "label": "clic « Apposer »" },
  { "wait": 2000 },
  { "assert": "document.querySelector('#sig-title') === null && document.querySelector('button[title^=\"Annuler : Apposer une signature\"]') !== null", "label": "signature apposée" },
  { "shot": "04-signee.png" },

  { "key": "s", "ctrl": true },
  { "wait": 1500 },
  { "assert": "!document.querySelector('[role=tablist][aria-label=MegaUltraPDF] [role=tab]').textContent.trim().endsWith('•')", "label": "enregistré" },

  { "eval": "(() => { [...document.querySelectorAll('.panel button')].find(b => b.textContent.trim().startsWith('Aplatir')).click(); return true; })()", "label": "clic « Aplatir… »" },
  { "wait": 300 },
  { "eval": "(() => { [...document.querySelectorAll('.panel button')].find(b => b.textContent.trim() === 'Aplatir').click(); return true; })()", "label": "confirmation de l'aplatissement" },
  { "wait": 2500 },
  { "assert": "document.querySelectorAll('.form-layer input').length === 0 && document.body.innerText.includes('0 champ')", "label": "aplati : plus de champs" },
  { "assert": "document.querySelector('button[title^=\"Annuler : Aplatir le formulaire\"]') !== null", "label": "libellé « Aplatir le formulaire »" },
  { "shot": "05-aplati.png" },
  { "key": "z", "ctrl": true },
  { "wait": 2500 },
  { "assert": "document.querySelectorAll('.form-layer input').length === 6", "label": "Ctrl+Z : champs revenus" }
]
