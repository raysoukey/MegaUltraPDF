[
  { "wait": 1500 },
  { "click": "button[title^='Propriétés']" },
  { "wait": 1200 },
  { "eval": "document.querySelector('[role=dialog]') ? document.querySelector('[role=dialog]').innerText.slice(0, 200) : 'PAS DE DIALOGUE'", "label": "dialogue via le bouton" },
  { "assert": "document.querySelectorAll('[role=dialog] tr').length >= 10", "label": "propriétés : tableau rempli (bouton)" },
  { "shot": "01-proprietes-bouton.png" },
  { "key": "Escape" },
  { "wait": 400 },
  { "assert": "document.querySelector('[role=dialog]') === null", "label": "Échap ferme le dialogue" },
  { "key": "i", "ctrl": true },
  { "wait": 1200 },
  { "assert": "document.querySelectorAll('[role=dialog] tr').length >= 10", "label": "propriétés : tableau rempli (Ctrl+I)" },
  { "shot": "02-proprietes-ctrl-i.png" },
  { "key": "Escape" },
  { "eval": "(() => { const s = document.querySelector('select[aria-label=\"Thème\"]'); s.value = 'light'; s.dispatchEvent(new Event('change', { bubbles: true })); return true; })()", "label": "thème clair demandé" },
  { "wait": 600 },
  { "assert": "document.documentElement.getAttribute('data-theme') === 'light'", "label": "attribut data-theme=light" },
  { "shot": "03-clair.png" },
  { "eval": "(() => { const s = document.querySelector('select[aria-label=\"Thème\"]'); s.value = 'system'; s.dispatchEvent(new Event('change', { bubbles: true })); return true; })()", "label": "retour système" }
]
